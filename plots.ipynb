    "\n",
    "plt.plot(eta, 10*np.log10(v))\n",
    "plt.xlabel(\"transmission $\\eta$\")\n",
    "plt.ylabel(\"Squeezing dB\")\n",
    "plt.title(\"Squeezing vs Loss\")\n",
    "plt.grid()\n",
    "plt.minorticks_on()"
